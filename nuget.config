<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet feed pinning. <clear/> discards any machine/user-level feeds, and the
  source mapping prevents dependency confusion: a package can only ever be resolved from
  the feed it is mapped to.

  TEMPORARY: `orkeon-local` points at orkeon-feed/ (git-ignored), a folder of Orkeon packages
  packed from source, because the packages Studio needs are not published on nuget.org yet.
  A build of the checkout reads them at OrkeonVersion (Directory.Packages.props), packed by
  scripts/pack-orkeon-feed.sh;
  scripts/install-from-source.* packs and reads its own dated versions there. Once Orkeon publishes them,
  remove the `orkeon-local` source and its mapping, and set OrkeonVersion to the published
  version: Orkeon.* then resolves from nuget.org like every other package.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="orkeon-local" value="orkeon-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="orkeon-local">
      <package pattern="Orkeon.*" />
      <package pattern="Orkeon" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
