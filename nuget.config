<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet feed pinning. <clear/> discards any machine/user-level feeds, and the
  source mapping prevents dependency confusion: a package can only ever be resolved from
  the feed it is mapped to. Orkeon.* comes from nuget.org at the OrkeonVersion of
  Directory.Packages.props, like every other package.

  scripts/install-from-source.* build Studio against packages packed from an Orkeon
  checkout: they write a nuget.config of their own, which adds their local feed, and
  never touch this one.
-->
<!--
  TEMPORARY (until Orkeon is tagged): Orkeon.* comes from dev-feed/,
  packages packed from Orkeon main (e7b9bdfa8: PRs #462 and #470 of Orkeon, untagged); main at b42e0139b (#474) changes the
  orkeon CLI only, no packaged assembly, so the drift tests read b42e0139b against the same packages. The closing commit removes dev-feed/
  and this source, and moves OrkeonVersion to the tag.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="orkeon-dev-feed" value="dev-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="orkeon-dev-feed">
      <package pattern="Orkeon" />
      <package pattern="Orkeon.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
