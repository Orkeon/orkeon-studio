<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet feed pinning. <clear/> discards any machine/user-level feeds, and the
  source mapping prevents dependency confusion: a package can only ever be resolved from
  the feed it is mapped to. Orkeon.* comes from nuget.org at the OrkeonVersion of
  Directory.Packages.props, like every other package.

  scripts/install-from-source.* build Studio against packages packed from an Orkeon
  checkout: they write a nuget.config of their own, which adds their local feed, and
  never touch this one.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
