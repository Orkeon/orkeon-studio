<!-- The models (and the decision provider) under test and the copyable log of the tests: the body shared
     by the « Test » settings tab and the last step of the guided setup. DataContext: ModelTestRunner. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.ModelTestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>
    <StackPanel Orientation="Horizontal">
      <Button Style="{StaticResource BtnSecondary}" Command="{Binding TestAllCommand}" controls:ButtonIcon.Kind="plug-zap"
              Content="{Binding [Studio.Settings.SandboxTestAll], Source={x:Static services:I18n.Instance}}"/>
      <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding StopCommand}" controls:ButtonIcon.Kind="square"
              Content="{Binding [Studio.Settings.SandboxStop], Source={x:Static services:I18n.Instance}}"
              Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}"/>
      <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding Summary}"
                 Visibility="{Binding Summary, Converter={StaticResource StringPresentToVisibility}}"/>
    </StackPanel>
    <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap"
               Text="{Binding [Studio.Settings.SandboxCost], Source={x:Static services:I18n.Instance}}"/>
    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"
               Text="{Binding [Studio.Settings.SandboxEmpty], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding HasRows, Converter={StaticResource InverseBooleanToVisibility}}"/>

    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="0,1,0,0" Padding="0,9">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" Command="{Binding OpenCommand}"
                        Content="{Binding [Studio.Settings.SandboxOpen], Source={x:Static services:I18n.Instance}}"
                        Visibility="{Binding CanOpen, Converter={StaticResource BooleanToVisibility}}"/>
                <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="8,0,0,0" Command="{Binding TestCommand}"
                        Content="{Binding [Studio.Settings.SandboxTest], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <controls:LucideIcon DockPanel.Dock="Left" Size="15" VerticalAlignment="Top" Margin="0,2,10,0">
                <controls:LucideIcon.Style>
                  <Style TargetType="controls:LucideIcon">
                    <Setter Property="Kind" Value="circle-dashed"/>
                    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="Running">
                        <Setter Property="Kind" Value="loader-circle"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Passed">
                        <Setter Property="Kind" Value="circle-check"/>
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter Property="Kind" Value="circle-x"/>
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Skipped">
                        <Setter Property="Kind" Value="triangle-alert"/>
                        <Setter Property="Foreground" Value="{DynamicResource WarningIconBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:LucideIcon.Style>
              </controls:LucideIcon>
              <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Text="{Binding Name}"/>
                <TextBlock Style="{StaticResource MetaText}" TextWrapping="Wrap" Text="{Binding Detail}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Message}"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <DockPanel Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"
                   Text="{Binding [Studio.Settings.SandboxJournalCopied], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding IsJournalCopied, Converter={StaticResource BooleanToVisibility}}"/>
        <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" Command="{Binding CopyJournalCommand}" controls:ButtonIcon.Kind="copy"
                Content="{Binding [Studio.Settings.SandboxJournalCopy], Source={x:Static services:I18n.Instance}}"/>
        <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" Command="{Binding SaveJournalCommand}" controls:ButtonIcon.Kind="save"
                Content="{Binding [Studio.Settings.SandboxJournalSave], Source={x:Static services:I18n.Instance}}"/>
        <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" Command="{Binding ClearJournalCommand}"
                Content="{Binding [Studio.Settings.SandboxJournalClear], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                 Text="{Binding [Studio.Settings.SandboxJournal], Source={x:Static services:I18n.Instance}}"/>
    </DockPanel>
    <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
               Text="{Binding [Studio.Settings.SandboxJournalEmpty], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding HasJournal, Converter={StaticResource InverseBooleanToVisibility}}"/>
    <controls:TechBlock Margin="0,5,0,0" MaxHeight="260" Text="{Binding JournalText, Mode=OneWay}"
                        Visibility="{Binding HasJournal, Converter={StaticResource BooleanToVisibility}}"/>
    <TextBlock FontSize="13" Foreground="{DynamicResource WarningInkBrush}" TextWrapping="Wrap" Margin="0,7,0,0" Text="{Binding SaveError}"
               Visibility="{Binding SaveError, Converter={StaticResource StringPresentToVisibility}}"/>
  </StackPanel>
</UserControl>
