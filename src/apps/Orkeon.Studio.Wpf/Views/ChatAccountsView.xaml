<!-- The "Microsoft Teams" settings tab (both modes), on the model of the Drive one: the Teams
     accounts and webhooks the chat tools use, the box that adds one, the form of the selected
     account and, expert only, the settings of the section. DataContext: ChatSectionViewModel (bound
     as Settings.Config.Chat); the form's own is the selected ChatAccountRowViewModel. A field left
     empty shows what the engine will use as a watermark (Tag). What only the expert sees carries the
     literal configuration key as a tooltip - technical identifiers, identical in every language,
     hence not routed through I18n. The address of a webhook and the client secret of an application
     are typed in a masked box and kept by the key store, outside any file: the file holds the name
     of the variable, which the expert alone reads. Each account says what the engine makes of it as
     the file was last saved - a dot and a word, from `orkeon chat accounts` - and "Test the
     connection" runs `orkeon chat check`. An account a person signs in has "Sign in", which runs
     `orkeon chat login`, and the panel under the state says what to do while it waits; Studio opens
     nothing by itself, and only ever an https address. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.ChatAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <UserControl.Resources>
    <!-- The state of an account as a dot - green when the engine finds it ready, amber when it
         lacks something or is set aside, muted when nothing could be read.
         DataContext: ChatAccountRowViewModel; the values are EmailAccountReadiness names. -->
    <Style x:Key="ChatStateDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="{DynamicResource InkMutedBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateKind}" Value="Ready">
          <Setter Property="Fill" Value="{DynamicResource SuccessInkBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKind}" Value="NotReady">
          <Setter Property="Fill" Value="{DynamicResource WarningIconBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKind}" Value="SetAside">
          <Setter Property="Fill" Value="{DynamicResource WarningIconBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The tabs of an account's form: the settings strip's underline, one size down. -->
    <Style x:Key="ChatTab" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Underline" Padding="2,0,2,6" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <!-- A02: the last card's 16 px and this 16 px end the tab 32 px above the end of the scroll (R02) -->
  <StackPanel Margin="0,0,0,16">

    <!-- ══ the head: what the tab is, the file it writes, the default account ══ -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <!-- C11: «Add an account» is secondary with its +, the screen's primary is «Save» (R05);
               with no account the empty state below carries it, so it shows once -->
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" VerticalAlignment="Top"
                  controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="plus"
                  Command="{Binding BeginAddCommand}"
                  Content="{Binding [Studio.Settings.MailAdd], Source={x:Static services:I18n.Instance}}"
                  Visibility="{Binding HasAccounts, Converter={StaticResource BooleanToVisibility}}"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <controls:LucideIcon Kind="message-circle" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}"
                       Text="{Binding [Studio.Settings.ChatTitle], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                   Text="{Binding [Studio.Settings.ChatIntro], Source={x:Static services:I18n.Instance}}"/>
        <!-- D-06: a run reads one settings file, so the tab says which one it writes -->
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding SettingsFileLine}"/>
        <!-- C17: no account yet - the shared empty state, whose one action is the add (R17) -->
        <controls:EmptyState Icon="message-circle" Margin="0,16,0,0"
                             Title="{Binding [Studio.Settings.MailEmptyTitle], Source={x:Static services:I18n.Instance}}"
                             Text="{Binding [Studio.Settings.ChatEmpty], Source={x:Static services:I18n.Instance}}"
                             Visibility="{Binding HasAccounts, Converter={StaticResource InverseBooleanToVisibility}}">
          <controls:EmptyState.Actions>
            <Button Style="{StaticResource BtnPrimary}" controls:ButtonIcon.Kind="plus"
                    Command="{Binding BeginAddCommand}"
                    Content="{Binding [Studio.Settings.MailAdd], Source={x:Static services:I18n.Instance}}"/>
          </controls:EmptyState.Actions>
        </controls:EmptyState>

        <StackPanel Visibility="{Binding HasAccounts, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                     Text="{Binding [Studio.Settings.MailDefaultAccount], Source={x:Static services:I18n.Instance}}"/>
          <ComboBox Style="{StaticResource ComboM}"
                    ItemsSource="{Binding DefaultAccountChoices}"
                    SelectedValue="{Binding DefaultAccount}" SelectedValuePath="Value" DisplayMemberPath="Label"
                    Tag="{Binding DefaultAccountPlaceholder}"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{Binding [Studio.Settings.MailDefaultAccountHint], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ══ the box that adds an account: nothing is written until it is validated ══ -->
    <Border Background="{DynamicResource AccentWeakBrush}" BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" CornerRadius="11" Padding="16,12" Margin="0,0,0,16"
            Visibility="{Binding IsAdding, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}"
                   Text="{Binding [Studio.Settings.MailNewTitle], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,5"
                   Text="{Binding [Studio.Settings.MailName], Source={x:Static services:I18n.Instance}}"/>
        <TextBox Style="{StaticResource InputMono}" Width="320" HorizontalAlignment="Left"
                 Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="{Binding [Studio.Settings.MailNameHint], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,5"
                   Text="{Binding [Studio.Settings.MailProvider], Source={x:Static services:I18n.Instance}}"/>
        <ComboBox Style="{StaticResource ComboM}"
                  ItemsSource="{Binding ProviderChoices}"
                  SelectedValue="{Binding NewAccountProvider}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
        <controls:Alert Tone="Danger" Margin="0,12,0,0" Message="{Binding AddRefusal}"
                        Visibility="{Binding HasAddRefusal, Converter={StaticResource BooleanToVisibility}}"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding ConfirmAddCommand}" controls:ButtonIcon.Kind="plus"
                  Content="{Binding [Studio.Settings.MailAddConfirm], Source={x:Static services:I18n.Instance}}"/>
          <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Command="{Binding CancelAddCommand}"
                  Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ══ the accounts: pick one, its form shows below ══ -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
            Visibility="{Binding HasAccounts, Converter={StaticResource BooleanToVisibility}}">
      <ListBox x:Name="AccountList" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
               Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" CornerRadius="9" Padding="10,8" Margin="0,0,0,4"
                          BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                      <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel LastChildFill="True">
              <!-- what the engine makes of the account, before it is opened -->
              <Ellipse DockPanel.Dock="Left" Style="{StaticResource ChatStateDot}" Margin="0,0,8,0"
                       ToolTip="{Binding State}"
                       Visibility="{Binding HasState, Converter={StaticResource BooleanToVisibility}}"/>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoText}" FontSize="13" TextWrapping="NoWrap"
                         VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
              <!-- an account the run will set aside says so before it is opened -->
              <controls:LucideIcon DockPanel.Dock="Right" Kind="triangle-alert" Size="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource WarningIconBrush}"
                                   Visibility="{Binding HasProblems, Converter={StaticResource BooleanToVisibility}}"/>
              <!-- the service, then the rights it grants -->
              <DockPanel Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" TextWrapping="NoWrap" VerticalAlignment="Center">
                  <Run Text="{Binding Provider, Mode=OneWay}"/>
                  <Run Text=" · "/>
                </TextBlock>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Text="{Binding RightsLine}"/>
              </DockPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- ══ the settings of the section (expert): they apply to every account, folded ══ -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
            Visibility="{Binding IsExpert, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <!-- C12: the one fold (R16) - «For every account» and its chevron, the label stable in
             both states; IsSectionOpen is the same switch ToggleSectionCommand flips -->
        <controls:Disclosure Header="{Binding [Studio.Settings.MailSectionTitle], Source={x:Static services:I18n.Instance}}"
                             IsExpanded="{Binding IsSectionOpen}">
          <controls:Disclosure.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" ToolTip="Orkeon:Tools:Chat"/>
            </DataTemplate>
          </controls:Disclosure.HeaderTemplate>
        <StackPanel>
          <CheckBox Margin="0,10,0,0" IsChecked="{Binding WithholdRejected}" Foreground="{DynamicResource InkBrush}"
                    ToolTip="Screening:WithholdRejected"
                    Content="{Binding [Studio.Settings.ChatWithholdRejected], Source={x:Static services:I18n.Instance}}"/>
          <TextBlock Style="{StaticResource SwitchHint}"
                     Text="{Binding [Studio.Settings.ChatWithholdRejectedHint], Source={x:Static services:I18n.Instance}}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5" ToolTip="CredentialsDirectory"
                     Text="{Binding [Studio.Settings.MailCredentialsDirectory], Source={x:Static services:I18n.Instance}}"/>
          <DockPanel MaxWidth="620" HorizontalAlignment="Left">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0"
                    Command="{Binding BrowseCredentialsDirectoryCommand}"
                    Content="{Binding [Studio.Common.Browse], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource InputMono}" Width="480"
                     Text="{Binding CredentialsDirectory, UpdateSourceTrigger=LostFocus}"
                     Tag="{Binding [Studio.Settings.MailCredentialsDirectoryDefault], Source={x:Static services:I18n.Instance}}"/>
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{Binding [Studio.Settings.MailCredentialsDirectoryHint], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        </controls:Disclosure>
      </StackPanel>
    </Border>

    <!-- ══ the selected account ══ -->
    <!-- D11: picking another account scrolls this form into view (SelectionReveal, R24) -->
    <!-- T-30: the form exists WITH a selection, not before one. An explicit ContentTemplate is
         instantiated even over a null Content: without this gate, a machine with no account
         shows the whole form of nobody, every conditional panel open at once. -->
    <ContentControl Content="{Binding SelectedAccount}" x:Name="AccountForm" Focusable="False"
                    Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibility}}">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <StackPanel>

            <!-- the account itself: its name, the questions, what the run will say of it -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel>
                  <!-- Two faces, never both: the action row, or the question that replaces it in place. -->
                  <Grid DockPanel.Dock="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibility}}">
                      <Button Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"
                              Command="{Binding DataContext.RenameAccountCommand, RelativeSource={RelativeSource AncestorType=views:ChatAccountsView}}"
                              CommandParameter="{Binding}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="pencil-line"
                              Content="{Binding [Studio.Settings.MailRename], Source={x:Static services:I18n.Instance}}"/>
                      <!-- R06: the account leaves the list until «Save» writes the file - a neutral ×, not the danger outline -->
                      <Button Style="{StaticResource BtnSecondary}"
                              Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=views:ChatAccountsView}}"
                              CommandParameter="{Binding}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="x"
                              Content="{Binding [Studio.Settings.MailRemove], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:LucideIcon Kind="message-circle" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Style="{StaticResource MonoText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
                  </StackPanel>
                </DockPanel>

                <!-- what the engine makes of the account as the file was last saved, then the
                     connection test. Nothing here is computed by Studio. -->
                <StackPanel Margin="0,10,0,0">
                  <DockPanel LastChildFill="True"
                             Visibility="{Binding HasState, Converter={StaticResource BooleanToVisibility}}">
                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource ChatStateDot}" VerticalAlignment="Top"
                             Margin="0,5,7,0"/>
                    <TextBlock Style="{StaticResource Subhead}" TextWrapping="Wrap"
                               Foreground="{DynamicResource InkBrush}" Text="{Binding State}"/>
                  </DockPanel>
                  <!-- the engine's own sentence: it names the variable to fill or the sign-in to run -->
                  <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="15,3,0,0" Text="{Binding StateDetail}"
                             Visibility="{Binding HasStateDetail, Converter={StaticResource BooleanToVisibility}}"/>
                  <!-- unsaved edits: the state is the saved file's, and the test waits for the save -->
                  <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                             Text="{Binding [Studio.Settings.MailStateOfSavedFile], Source={x:Static services:I18n.Instance}}"
                             Visibility="{Binding DataContext.IsStateOfSavedFile, RelativeSource={RelativeSource AncestorType=views:ChatAccountsView}, Converter={StaticResource BooleanToVisibility}}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- the one gesture that connects for real: never run on its own, stopped when the tab is left -->
                    <Button Style="{StaticResource BtnSecondary}" Command="{Binding TestCommand}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="plug-zap"
                            Content="{Binding [Studio.Settings.MailTest], Source={x:Static services:I18n.Instance}}"/>
                    <!-- for an account a person signs in; both read the file as saved, like the test -->
                    <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Command="{Binding SignInCommand}"
                            Visibility="{Binding ShowSignIn, Converter={StaticResource BooleanToVisibility}}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="key-round"
                            Content="{Binding [Studio.Settings.MailSignIn], Source={x:Static services:I18n.Instance}}"/>
                    <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Command="{Binding SignOutCommand}"
                            Visibility="{Binding ShowSignIn, Converter={StaticResource BooleanToVisibility}}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="eraser"
                            Content="{Binding [Studio.Settings.MailSignOut], Source={x:Static services:I18n.Instance}}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{Binding [Studio.Settings.MailTesting], Source={x:Static services:I18n.Instance}}"
                               Visibility="{Binding IsTesting, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                  <!-- the verdict: a localized word, then the engine's sentence as printed -->
                  <!-- R07: the verdict is the shared banner - success when the server answered, warning
                       otherwise; the engine's sentence, as printed, is its folded technical details (R18) -->
                  <controls:Alert Margin="0,10,0,0" Message="{Binding LastCheckHeadline}" Details="{Binding LastCheckDetail}"
                                  Visibility="{Binding HasLastCheck, Converter={StaticResource BooleanToVisibility}}">
                    <controls:Alert.Style>
                      <Style TargetType="{x:Type controls:Alert}" BasedOn="{StaticResource {x:Type controls:Alert}}">
                        <Setter Property="Tone" Value="Warning"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LastCheckReachable}" Value="True">
                            <Setter Property="Tone" Value="Success"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </controls:Alert.Style>
                    <TextBlock TextWrapping="Wrap" Text="{Binding LastCheckHint}"
                               Visibility="{Binding HasLastCheckHint, Converter={StaticResource BooleanToVisibility}}"/>
                  </controls:Alert>
                  <!-- a sign-out the verb refused - a localized word, then its sentence as printed -->
                  <controls:Alert Tone="Warning" Margin="0,10,0,0" Message="{Binding [Studio.Settings.MailSignOutFailed], Source={x:Static services:I18n.Instance}}"
                                  Details="{Binding SignOutFailure}" Visibility="{Binding HasSignOutFailure, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>

                <!-- the sign-in in flight: `orkeon chat login` runs the OAuth flow and stores the
                     tokens; this panel only says what to do meanwhile, and waits. The outer border
                     reads the row (HasSignIn), the inner panel the EmailSignInViewModel the
                     account tabs share. -->
                <Border Background="{DynamicResource AccentWeakBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,12,0,0"
                        Visibility="{Binding HasSignIn, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel DataContext="{Binding SignIn}">

                    <!-- before the verb said anything -->
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{Binding [Studio.Settings.MailSignInStarting], Source={x:Static services:I18n.Instance}}"
                               Visibility="{Binding IsStarting, Converter={StaticResource BooleanToVisibility}}"/>

                    <!-- the device sign-in: the page, the code in large, the time it has left -->
                    <StackPanel Visibility="{Binding IsDeviceCode, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock Style="{StaticResource Subhead}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource InkBrush}" Text="{Binding DeviceCodeLine}"/>
                      <!-- a read-only well, so the code can be selected; it is never copied by a button -->
                      <TextBox Style="{StaticResource InputMono}" FontSize="26" FontWeight="SemiBold" IsReadOnly="True"
                               Height="Auto" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left" Text="{Binding UserCode, Mode=OneWay}"/>
                      <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding ExpiresInText}"
                                 Visibility="{Binding HasExpiry, Converter={StaticResource BooleanToVisibility}}"/>
                    </StackPanel>

                    <!-- the browser sign-in: what to do with the address below -->
                    <TextBlock Style="{StaticResource Subhead}" TextWrapping="Wrap"
                               Foreground="{DynamicResource InkBrush}"
                               Text="{Binding [Studio.Settings.MailAuthorizationUrl], Source={x:Static services:I18n.Instance}}"
                               Visibility="{Binding IsAuthorizationUrl, Converter={StaticResource BooleanToVisibility}}"/>

                    <!-- the address, in clear and selectable, then the two gestures on it -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasAddress, Converter={StaticResource BooleanToVisibility}}">
                      <TextBox Style="{StaticResource InputMono}" IsReadOnly="True" TextWrapping="Wrap"
                               Text="{Binding Address, Mode=OneWay}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource BtnSecondary}" Command="{Binding CopyLinkCommand}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="copy"
                                Content="{Binding [Studio.Settings.MailCopyLink], Source={x:Static services:I18n.Instance}}"/>
                        <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding OpenCommand}"
                                Visibility="{Binding CanOpen, Converter={StaticResource BooleanToVisibility}}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="external-link"
                                Content="{Binding [Studio.Settings.MailOpenInBrowser], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- the browser could not come back to this machine: the address it ended on is pasted here -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding IsAuthorizationUrl, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                 Text="{Binding [Studio.Settings.MailPasteRedirect], Source={x:Static services:I18n.Instance}}"/>
                      <DockPanel Margin="0,6,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0"
                                Command="{Binding SubmitRedirectCommand}"
                                Content="{Binding [Studio.Settings.MailPasteRedirectSend], Source={x:Static services:I18n.Instance}}"/>
                        <TextBox Style="{StaticResource InputMono}" Tag="http://127.0.0.1:…"
                                 Text="{Binding PastedRedirect, UpdateSourceTrigger=PropertyChanged}">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SubmitRedirectCommand}"/>
                          </TextBox.InputBindings>
                        </TextBox>
                      </DockPanel>
                      <controls:Alert Tone="Warning" Margin="0,8,0,0" Message="{Binding [Studio.Settings.MailPasteRedirectNotSent], Source={x:Static services:I18n.Instance}}"
                                      Visibility="{Binding RedirectNotSent, Converter={StaticResource BooleanToVisibility}}"/>
                      <!-- the verb rejected the address, and still waits: its sentence as printed, the address back in the field -->
                      <controls:Alert Tone="Warning" Margin="0,8,0,0" Message="{Binding [Studio.Settings.MailPasteRedirectRejected], Source={x:Static services:I18n.Instance}}"
                                      Details="{Binding RedirectRejectedDetail}" Visibility="{Binding RedirectRejected, Converter={StaticResource BooleanToVisibility}}"/>
                    </StackPanel>

                    <!-- the three ends -->
                    <controls:Alert Tone="Success" Message="{Binding [Studio.Settings.MailSignedIn], Source={x:Static services:I18n.Instance}}"
                                    Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibility}}"/>
                    <controls:Alert Tone="Warning" Message="{Binding [Studio.Settings.MailDeviceCodeExpired], Source={x:Static services:I18n.Instance}}"
                                    Visibility="{Binding IsExpired, Converter={StaticResource BooleanToVisibility}}"/>
                    <controls:Alert Tone="Warning" Message="{Binding [Studio.Settings.MailSignInFailed], Source={x:Static services:I18n.Instance}}"
                                    Details="{Binding FailureDetail}" Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock TextWrapping="Wrap" Text="{Binding [Studio.Settings.ChatSignInFailedHint], Source={x:Static services:I18n.Instance}}"/>
                    </controls:Alert>

                    <!-- one way out, whatever the phase: it stops the child while one waits -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <Button Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding RestartCommand}"
                              Visibility="{Binding CanRestart, Converter={StaticResource BooleanToVisibility}}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="rotate-ccw"
                              Content="{Binding [Studio.Settings.MailSignInRestart], Source={x:Static services:I18n.Instance}}"/>
                      <Button Command="{Binding CancelCommand}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                            <Setter Property="Content" Value="{Binding [Studio.Shell.Close], Source={x:Static services:I18n.Instance}}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                <Setter Property="Content" Value="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- D-07: the rename editor says what a rename costs before it moves anything -->
                <Border Background="{DynamicResource AccentWeakBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Subhead}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentInkBrush}"
                                 Text="{Binding [Studio.Settings.MailRenameLabel], Source={x:Static services:I18n.Instance}}"/>
                      <TextBox Style="{StaticResource InputMono}" Width="220" Margin="8,0,0,0" VerticalAlignment="Center"
                               Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"/>
                      <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding ConfirmRenameCommand}" controls:ButtonIcon.Kind="pencil-line"
                              Content="{Binding [Studio.Settings.MailRename], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Command="{Binding CancelRenameCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding [Studio.Settings.ChatRenameCost], Source={x:Static services:I18n.Instance}}"/>
                    <controls:Alert Tone="Danger" Margin="0,8,0,0" Message="{Binding RenameRefusal}"
                                    Visibility="{Binding HasRenameRefusal, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                </Border>

                <!-- D-07: the removal confirmation says what stays on the machine. R07: the shared
                     banner; the account only leaves the list until «Save», so the tone is the
                     warning and the confirmation the neutral × (R06) -->
                <controls:Alert Tone="Warning" Margin="0,12,0,0" Title="{Binding [Studio.Settings.MailRemoveQuestion], Source={x:Static services:I18n.Instance}}"
                                Message="{Binding [Studio.Settings.ChatRemoveCost], Source={x:Static services:I18n.Instance}}" Visibility="{Binding IsConfirmingRemove, Converter={StaticResource BooleanToVisibility}}">
                  <controls:Alert.Actions>
                    <StackPanel Style="{StaticResource ActionRow}">
                      <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="x" Margin="0,0,8,0"
                              Command="{Binding ConfirmRemoveCommand}" Content="{Binding [Studio.Settings.MailRemove], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32"
                              Command="{Binding CancelRemoveCommand}" Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </controls:Alert.Actions>
                </controls:Alert>

                <!-- signing out asks first - the account will need a new sign-in -->
                <controls:Alert Tone="Danger" Margin="0,12,0,0" Message="{Binding SignOutConfirmText}"
                                Visibility="{Binding IsConfirmingSignOut, Converter={StaticResource BooleanToVisibility}}">
                  <controls:Alert.Actions>
                    <StackPanel Style="{StaticResource ActionRow}">
                      <Button Style="{StaticResource BtnDangerSolid}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="eraser" Margin="0,0,8,0"
                              Command="{Binding ConfirmSignOutCommand}" Content="{Binding [Studio.Settings.MailSignOut], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32"
                              Command="{Binding CancelSignOutCommand}" Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </controls:Alert.Actions>
                </controls:Alert>

                <!-- what the run will say of the account as the file holds it: warnings, the file saves -->
                <controls:Alert Tone="Warning" Margin="0,12,0,0" Message="{Binding [Studio.Settings.MailProblemsTitle], Source={x:Static services:I18n.Instance}}"
                                Visibility="{Binding HasProblems, Converter={StaticResource BooleanToVisibility}}">
                  <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,3,0,0">
                          <TextBlock TextWrapping="Wrap" Text="{Binding FriendlyText}"/>
                          <!-- the engine's own sentence names the key: the expert's -->
                          <TextBlock Style="{StaticResource MonoText}" FontSize="13" TextWrapping="Wrap" Margin="0,1,0,0"
                                     Text="{Binding Text}"
                                     Visibility="{Binding DataContext.IsExpert, RelativeSource={RelativeSource AncestorType=views:ChatAccountsView}, Converter={StaticResource BooleanToVisibility}}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </controls:Alert>
                <controls:Alert Tone="Danger" Margin="0,12,0,0" Message="{Binding [Studio.Settings.MailNumberUnread], Source={x:Static services:I18n.Instance}}"
                                Visibility="{Binding HasUnreadNumber, Converter={StaticResource BooleanToVisibility}}"/>

              </StackPanel>
            </Border>

            <!-- the form, in three tabs: the account, its rights, its sign-in. The head above keeps
                 the state and the verdict whichever shows. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                  <Button Style="{StaticResource ChatTab}" Command="{Binding ShowAccountTabCommand}" Tag="{Binding IsAccountTab}"
                          Content="{Binding [Studio.Settings.MailTabAccount], Source={x:Static services:I18n.Instance}}"/>
                  <Button Style="{StaticResource ChatTab}" Command="{Binding ShowRightsTabCommand}" Tag="{Binding IsRightsTab}"
                          Content="{Binding [Studio.Settings.MailTabRights], Source={x:Static services:I18n.Instance}}"/>
                  <Button Style="{StaticResource ChatTab}" Command="{Binding ShowAuthTabCommand}" Tag="{Binding IsAuthTab}"
                          Content="{Binding [Studio.Settings.MailTabAuth], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>

                <!-- ── the account: its service and its cap of writes ── -->
                <StackPanel Visibility="{Binding IsAccountTab, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,5"
                           Text="{Binding [Studio.Settings.MailProvider], Source={x:Static services:I18n.Instance}}"/>
                <ComboBox Style="{StaticResource ComboM}"
                          ItemsSource="{Binding DataContext.ProviderChoices, RelativeSource={RelativeSource AncestorType=views:ChatAccountsView}}"
                          SelectedValue="{Binding Provider}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                <StackPanel Visibility="{Binding ShowMaxPerHour, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5" ToolTip="Send:MaxPerHour"
                             Text="{Binding [Studio.Settings.ChatMaxPerHour], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource Input}" Width="160" HorizontalAlignment="Left"
                           Text="{Binding MaxPerHour, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.ChatMaxPerHourHint], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
                </StackPanel>

                <!-- ── the rights: a switch for each the account can hold; none on and the engine refuses the account ── -->
                <StackPanel Visibility="{Binding IsRightsTab, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="{Binding [Studio.Settings.MailRightsIntro], Source={x:Static services:I18n.Instance}}"/>
                <CheckBox Margin="0,12,0,0" IsChecked="{Binding CanRead}" Foreground="{DynamicResource InkBrush}"
                          Content="{Binding [Studio.Settings.ChatRightRead], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding ShowRead, Converter={StaticResource BooleanToVisibility}}"/>
                <CheckBox Margin="0,7,0,0" IsChecked="{Binding CanMeetings}" Foreground="{DynamicResource InkBrush}"
                          Content="{Binding [Studio.Settings.ChatRightMeetings], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding ShowMeetings, Converter={StaticResource BooleanToVisibility}}"/>
                <!-- an empty list means nowhere; set under the switches' labels (34 px track + 10 px gap, #22) -->
                <StackPanel Margin="44,8,0,4" Visibility="{Binding ShowReadPlaces, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" ToolTip="Read:AllowedPlaces"
                             Text="{Binding [Studio.Settings.ChatReadPlaces], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,7" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.ChatPlacesHint], Source={x:Static services:I18n.Instance}}"/>
                  <ItemsControl ItemsSource="{Binding ReadPlaces}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,7">
                          <DockPanel MaxWidth="520" HorizontalAlignment="Left">
                            <!-- R06: a line taken out of the list before «Save» - a neutral × -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    controls:ButtonIcon.Kind="x"
                                    ToolTip="{Binding [Studio.Settings.MailRemove], Source={x:Static services:I18n.Instance}}"
                                    AutomationProperties.Name="{Binding [Studio.Settings.MailRemove], Source={x:Static services:I18n.Instance}}"
                                    Command="{Binding DataContext.RemovePlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <TextBox Style="{StaticResource InputMono}" Width="460"
                                     Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}"/>
                          </DockPanel>
                          <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerInkBrush}" Margin="0,3,0,0"
                                     Text="{Binding [Studio.Settings.ChatPlaceInvalid], Source={x:Static services:I18n.Instance}}"
                                     Visibility="{Binding IsInvalid, Converter={StaticResource BooleanToVisibility}}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Command="{Binding AddReadPlaceCommand}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="plus"
                          Content="{Binding [Studio.Settings.ChatPlaceAdd], Source={x:Static services:I18n.Instance}}"/>
                  <controls:Alert Tone="Warning" Margin="0,8,0,0" Message="{Binding [Studio.Settings.ChatReadClosed], Source={x:Static services:I18n.Instance}}"
                                  Visibility="{Binding ShowReadClosed, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
                <CheckBox Margin="0,7,0,0" IsChecked="{Binding CanSend}" Foreground="{DynamicResource InkBrush}"
                          Content="{Binding [Studio.Settings.ChatRightSend], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding ShowSend, Converter={StaticResource BooleanToVisibility}}"/>
                <CheckBox Margin="0,7,0,0" IsChecked="{Binding CanSend}" Foreground="{DynamicResource InkBrush}"
                          Content="{Binding [Studio.Settings.ChatRightSendWebhook], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding IsWebhook, Converter={StaticResource BooleanToVisibility}}"/>
                <CheckBox Margin="0,7,0,0" IsChecked="{Binding CanEdit}" Foreground="{DynamicResource InkBrush}"
                          Content="{Binding [Studio.Settings.ChatRightEdit], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding ShowEdit, Converter={StaticResource BooleanToVisibility}}"/>
                <CheckBox Margin="0,7,0,0" IsChecked="{Binding CanDelete}" Foreground="{DynamicResource InkBrush}"
                          Content="{Binding [Studio.Settings.ChatRightDelete], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding ShowDelete, Converter={StaticResource BooleanToVisibility}}"/>
                <CheckBox Margin="0,7,0,0" IsChecked="{Binding CanReact}" Foreground="{DynamicResource InkBrush}"
                          Content="{Binding [Studio.Settings.ChatRightReact], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding ShowReact, Converter={StaticResource BooleanToVisibility}}"/>
                <!-- an empty list means nowhere; set under the switches' labels (34 px track + 10 px gap, #22) -->
                <StackPanel Margin="44,8,0,4" Visibility="{Binding ShowSendPlaces, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" ToolTip="Send:AllowedPlaces"
                             Text="{Binding [Studio.Settings.ChatSendPlaces], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,7" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.ChatPlacesHint], Source={x:Static services:I18n.Instance}}"/>
                  <ItemsControl ItemsSource="{Binding SendPlaces}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,7">
                          <DockPanel MaxWidth="520" HorizontalAlignment="Left">
                            <!-- R06: a line taken out of the list before «Save» - a neutral × -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    controls:ButtonIcon.Kind="x"
                                    ToolTip="{Binding [Studio.Settings.MailRemove], Source={x:Static services:I18n.Instance}}"
                                    AutomationProperties.Name="{Binding [Studio.Settings.MailRemove], Source={x:Static services:I18n.Instance}}"
                                    Command="{Binding DataContext.RemovePlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <TextBox Style="{StaticResource InputMono}" Width="460"
                                     Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}"/>
                          </DockPanel>
                          <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerInkBrush}" Margin="0,3,0,0"
                                     Text="{Binding [Studio.Settings.ChatPlaceInvalid], Source={x:Static services:I18n.Instance}}"
                                     Visibility="{Binding IsInvalid, Converter={StaticResource BooleanToVisibility}}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Command="{Binding AddSendPlaceCommand}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="plus"
                          Content="{Binding [Studio.Settings.ChatPlaceAdd], Source={x:Static services:I18n.Instance}}"/>
                  <controls:Alert Tone="Warning" Margin="0,8,0,0" Message="{Binding [Studio.Settings.ChatSendClosed], Source={x:Static services:I18n.Instance}}"
                                  Visibility="{Binding ShowSendClosed, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
                </StackPanel>

                <!-- ── signing in: the application and its tenant, what an administrator granted, the secret; the rest for the expert ── -->
                <StackPanel Visibility="{Binding IsAuthTab, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Visibility="{Binding ShowAuthMethod, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,5" ToolTip="Auth:Method"
                             Text="{Binding [Studio.Settings.MailAuthMethod], Source={x:Static services:I18n.Instance}}"/>
                  <ComboBox Style="{StaticResource ComboM}"
                            ItemsSource="{Binding DataContext.AuthMethodChoices, RelativeSource={RelativeSource AncestorType=views:ChatAccountsView}}"
                            SelectedValue="{Binding AuthMethod}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowApplication, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,5" ToolTip="Auth:ClientId"
                             Text="{Binding [Studio.Settings.MailClientId], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource InputMono}" Width="520" HorizontalAlignment="Left"
                           Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.ChatClientIdHint], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5" ToolTip="Auth:Tenant"
                             Text="{Binding [Studio.Settings.MailTenant], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource InputMono}" Width="520" HorizontalAlignment="Left" Tag="organizations"
                           Text="{Binding Tenant, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.ChatTenantHint], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>

                <!-- what an administrator of the tenant granted: the sign-in asks for no more -->
                <StackPanel Visibility="{Binding ShowGrants, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,3" ToolTip="Auth:AdminGranted"
                             Text="{Binding [Studio.Settings.ChatGrants], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.ChatGrantsHint], Source={x:Static services:I18n.Instance}}"/>
                  <CheckBox Margin="0,7,0,0" IsChecked="{Binding GrantChannelMessages}" Foreground="{DynamicResource InkBrush}"
                            Content="{Binding [Studio.Settings.ChatGrantChannelMessages], Source={x:Static services:I18n.Instance}}"/>
                  <CheckBox Margin="0,7,0,0" IsChecked="{Binding GrantChannelEdit}" Foreground="{DynamicResource InkBrush}"
                            Content="{Binding [Studio.Settings.ChatGrantChannelEdit], Source={x:Static services:I18n.Instance}}"/>
                  <CheckBox Margin="0,7,0,0" IsChecked="{Binding GrantChannelMembers}" Foreground="{DynamicResource InkBrush}"
                            Content="{Binding [Studio.Settings.ChatGrantChannelMembers], Source={x:Static services:I18n.Instance}}"/>
                  <CheckBox Margin="0,7,0,0" IsChecked="{Binding GrantMeetings}" Foreground="{DynamicResource InkBrush}"
                            Content="{Binding [Studio.Settings.ChatGrantMeetings], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>

                <!-- the secret - the address of a webhook, the client secret of an application - typed here, kept by the key store -->
                <StackPanel Visibility="{Binding ShowSecret, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                             Text="{Binding SecretLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <!-- A secret even in transit (T-31): masked while it is typed or pasted, wiped once kept. -->
                    <PasswordBox Style="{StaticResource InputPassword}" Width="320" VerticalAlignment="Center" Margin="0,0,8,0"
                                 views:PasswordBinding.Text="{Binding Secret.KeyInput}"/>
                    <Button Style="{StaticResource BtnSecondary}" Command="{Binding Secret.StoreCommand}"
                            Content="{Binding [Studio.Settings.SecretStore], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.ChatWebhookUrlHint], Source={x:Static services:I18n.Instance}}"
                             Visibility="{Binding IsWebhook, Converter={StaticResource BooleanToVisibility}}"/>
                  <!-- the state, never the value: saving again replaces what is kept -->
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding SecretStatus}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                        <Setter Property="Foreground" Value="{DynamicResource WarningInkBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SecretStored}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessInkBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <!-- where it is kept: the expert's line, empty for the novice -->
                  <TextBlock Style="{StaticResource MonoText}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                             Text="{Binding SecretVariableLine}"
                             Visibility="{Binding SecretVariableLine, Converter={StaticResource StringPresentToVisibility}}"/>
                  <!-- STUDIO-44: kept for this session even when the user scope refused it; the line says why -->
                  <controls:Alert Tone="Warning" Margin="0,8,0,0" Message="{Binding Secret.StoreError}"
                                  Visibility="{Binding Secret.HasStoreError, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowWebhookEnvVar, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5" ToolTip="Webhook:UrlEnvVar"
                             Text="{Binding [Studio.Settings.ChatWebhookUrlEnvVar], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource InputMono}" Width="320" HorizontalAlignment="Left"
                           Text="{Binding WebhookEnvVar, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.MailEnvVarHint], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowClientSecretEnvVar, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5" ToolTip="Auth:ClientSecretEnvVar"
                             Text="{Binding [Studio.Settings.MailClientSecretEnvVar], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource InputMono}" Width="320" HorizontalAlignment="Left"
                           Text="{Binding ClientSecretEnvVar, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.MailEnvVarHint], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowCertificateEnvVar, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5" ToolTip="Auth:CertificatePathEnvVar"
                             Text="{Binding [Studio.Settings.ChatCertificateEnvVar], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource InputMono}" Width="320" HorizontalAlignment="Left"
                           Text="{Binding CertificatePathEnvVar, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.MailEnvVarHint], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowFederatedTokenFileEnvVar, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5" ToolTip="Auth:FederatedTokenFileEnvVar"
                             Text="{Binding [Studio.Settings.ChatFederatedTokenEnvVar], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource InputMono}" Width="320" HorizontalAlignment="Left"
                           Text="{Binding FederatedTokenFileEnvVar, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.MailEnvVarHint], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowCloud, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5" ToolTip="Cloud"
                             Text="{Binding [Studio.Settings.ChatCloud], Source={x:Static services:I18n.Instance}}"/>
                  <ComboBox Style="{StaticResource ComboM}"
                            ItemsSource="{Binding DataContext.CloudChoices, RelativeSource={RelativeSource AncestorType=views:ChatAccountsView}}"
                            SelectedValue="{Binding Cloud}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

  </StackPanel>
</UserControl>
