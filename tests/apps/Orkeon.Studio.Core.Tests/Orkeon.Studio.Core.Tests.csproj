<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\apps\Orkeon.Studio.Core\Orkeon.Studio.Core.csproj" />
    <!-- STUDIO-51: the cmd and C runtime models every launcher writer's suite reads run.cmd with. -->
    <ProjectReference Include="..\..\shared\Orkeon.Studio.Tests.Shared\Orkeon.Studio.Tests.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Core does not need Infrastructure, Tools or Hosting (see its csproj). The test project
      does, so ConstantDriftTests and DirectoryLayoutEquivalenceTests can check Core's copies
      against the real thing. Orkeon.Scripting carries Orkeon.Hosting.dll.

      ExcludeAssets="build" is the opt-out Orkeon 1.2.0 supports (Orkeon #368, #376):
      Orkeon.Scripting reaches SmartComponents.LocalEmbeddings through
      Orkeon.Tools.Embeddings.Local, whose build target would download the BGE-micro-v2
      weights (~17 MB) from huggingface.co on a first build, fail an offline one, and copy
      them to LocalEmbeddingsModel/. No Studio test embeds anything. NuGet unions the flags
      of every path to a package, so a new reference that reaches it needs the same flag.
    -->
    <PackageReference Include="Orkeon" />
    <PackageReference Include="Orkeon.Tools" />
    <PackageReference Include="Orkeon.Scripting" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Email and Drive oracle and drift tests bind Studio's settings through the engine's own
      option types, account registries and OAuth settings, which Orkeon keeps internal.
      Publicizer compiles this project against public copies of those assemblies and emits
      IgnoresAccessChecksTo for the runtime. The test project only: Studio itself never reaches
      into Orkeon internals.
    -->
    <PackageReference Include="Krafs.Publicizer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Publicize Include="Orkeon.Tools.Email" />
    <Publicize Include="Orkeon.Tools.Drive" />
    <Publicize Include="Orkeon.Tools.Abstractions" />
  </ItemGroup>

</Project>
